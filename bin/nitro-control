    # ------------------------------------------------------------------
    # TAB 3: CPU & GPU Load UI
    # ------------------------------------------------------------------
    def create_load_tab(self):
        scroller = Gtk.ScrolledWindow()
        scroller.set_vexpand(True)
        scroller.set_hexpand(True)

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        box.set_margin_top(16)
        box.set_margin_bottom(20)
        box.set_margin_start(18)
        box.set_margin_end(18)

        clamp = Adw.Clamp(maximum_size=600)
        clamp.set_child(box)
        scroller.set_child(clamp)

        gpu_group = Adw.PreferencesGroup(title="Видеокарты и распределение нагрузки")
        box.append(gpu_group)

        self.igpu_row = Adw.ActionRow(
            title="AMD Radeon Vega (Встроенная iGPU)",
            subtitle="Рендерит рабочий стол Hyprland, интерфейс и экран 144 Гц"
        )
        gpu_group.add(self.igpu_row)

        self.dgpu_row = Adw.ActionRow(
            title="NVIDIA GeForce RTX 3060 (Дискретная dGPU)",
            subtitle="Проверка статуса..."
        )
        gpu_group.add(self.dgpu_row)

        self.dgpu_apps_row = Adw.ActionRow(
            title="Программы на видеокарте NVIDIA",
