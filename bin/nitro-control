        )
        gpu_group.add(self.dgpu_apps_row)

        self.top_cpu_group = Adw.PreferencesGroup(title="Программы, грузящие процессор (CPU)")
        box.append(self.top_cpu_group)

        self.cpu_proc_rows = []
        for _ in range(8):
            row = Adw.ActionRow(title="--", subtitle="--")
            lbl = Gtk.Label(label="--")
            lbl.add_css_class("numeric")
            row.add_suffix(lbl)
            self.top_cpu_group.add(row)
            self.cpu_proc_rows.append((row, lbl))

        return scroller

    # ------------------------------------------------------------------
    # Control Callbacks & Logic
    # ------------------------------------------------------------------
    def on_manual_toggle(self, switch, gparam):
        is_manual = self.manual_switch.get_active()

        # Disable/Enable buttons and sliders
        self.btn_box.set_sensitive(not is_manual)
        self.scale_cpu.set_sensitive(is_manual)
        self.scale_gpu.set_sensitive(is_manual)

        if is_manual:
            self.current_user_mode = "manual"
            self.apply_manual_speed()
        else:
            # Switch back to Smart Auto mode by default
            self.on_mode_smart(None)

    def on_mode_turbo(self, btn):
        if self.manual_switch.get_active():
            return
        self.current_user_mode = "turbo"
        if self.hwmon:
            write_val(os.path.join(self.hwmon, "pwm1_enable"), 0)
            write_val(os.path.join(self.hwmon, "pwm2_enable"), 0)
        try:
            with open(OVERRIDE_FILE, "w") as f:
                f.write("turbo")
            self.fan_status_label.set_text("Текущий режим: ТУРБО (Максимальные обороты 100%)")
        except Exception as e:
            self.fan_status_label.set_text(f"Ошибка: {e}")

        # Synchronize Sliders & Labels to 100%
        self.set_sliders_display(100, 100)

    def on_mode_smart(self, btn):
        if self.manual_switch.get_active():
            return
        self.current_user_mode = "smart"
        if self.hwmon:
            write_val(os.path.join(self.hwmon, "pwm1_enable"), 2)
            write_val(os.path.join(self.hwmon, "pwm2_enable"), 2)
        try:
            if os.path.exists(OVERRIDE_FILE):
                os.remove(OVERRIDE_FILE)
            self.fan_status_label.set_text("Текущий режим: Умный Автофан активен (динамическое охлаждение)")
        except Exception as e:
            self.fan_status_label.set_text(f"Ошибка: {e}")

        self.sync_sliders_from_hw()

    def on_mode_auto(self, btn):
        if self.manual_switch.get_active():
            return
        self.current_user_mode = "auto"
        if self.hwmon:
            write_val(os.path.join(self.hwmon, "pwm1_enable"), 2)
            write_val(os.path.join(self.hwmon, "pwm2_enable"), 2)
        try:
            with open(OVERRIDE_FILE, "w") as f:
                f.write("auto")
            self.fan_status_label.set_text("Текущий режим: Заводской Автоматический (тихий)")
        except Exception as e:
            self.fan_status_label.set_text(f"Ошибка: {e}")

        self.sync_sliders_from_hw()

    def on_manual_change(self, scale):
        if self.updating_programmatically or not self.manual_switch.get_active():
            return
        self.apply_manual_speed()

    def apply_manual_speed(self):
        val_cpu = int(self.scale_cpu.get_value())
        val_gpu = int(self.scale_gpu.get_value())

        # Update percentage labels next to sliders
        self.cpu_pct_label.set_markup(f"<span weight='bold'>{val_cpu}%</span>")
        self.gpu_pct_label.set_markup(f"<span weight='bold'>{val_gpu}%</span>")

        # Hardware manual PWM values (0-255)
        s1 = int(val_cpu * 255 / 100)
        s2 = int(val_gpu * 255 / 100)
        if self.hwmon:
            write_val(os.path.join(self.hwmon, "pwm1_enable"), 1)
            write_val(os.path.join(self.hwmon, "pwm1"), s1)
            write_val(os.path.join(self.hwmon, "pwm2_enable"), 1)
            write_val(os.path.join(self.hwmon, "pwm2"), s2)

        try:
            with open(OVERRIDE_FILE, "w") as f:
                f.write(f"manual:{s1}:{s2}")
            self.fan_status_label.set_text(f"Текущий режим: Ручной (CPU {val_cpu}%, GPU {val_gpu}%)")
        except Exception as e:
            self.fan_status_label.set_text(f"Ошибка: {e}")

    def set_sliders_display(self, cpu_pct, gpu_pct):
        self.updating_programmatically = True
        self.scale_cpu.set_value(cpu_pct)
        self.scale_gpu.set_value(gpu_pct)
        self.cpu_pct_label.set_markup(f"<span weight='bold'>{int(cpu_pct)}%</span>")
        self.gpu_pct_label.set_markup(f"<span weight='bold'>{int(gpu_pct)}%</span>")
        self.updating_programmatically = False

    def sync_sliders_from_hw(self):
        if not self.hwmon:
            return
        pwm1 = read_val(os.path.join(self.hwmon, "pwm1"), 128)
        pwm2 = read_val(os.path.join(self.hwmon, "pwm2"), 128)
        c_pct = max(20, min(100, int(pwm1 * 100 / 255)))
        g_pct = max(20, min(100, int(pwm2 * 100 / 255)))
        self.set_sliders_display(c_pct, g_pct)

    # ------------------------------------------------------------------
    # Live Data Refresh
    # ------------------------------------------------------------------
    def update_all(self):
        self.update_fans()
        self.update_ram()
        self.update_load()
        return True

    def update_fans(self):
        if not self.hwmon or not os.path.exists(self.hwmon):
            self.hwmon = find_ec_hwmon()
            if not self.hwmon:
                return

        cpu_rpm = read_val(os.path.join(self.hwmon, "fan1_input"), 0)
        gpu_rpm = read_val(os.path.join(self.hwmon, "fan2_input"), 0)

        t_cpu = read_val(os.path.join(self.hwmon, "temp1_input"), 0) / 1000.0
        t_gpu = read_val(os.path.join(self.hwmon, "temp2_input"), 0) / 1000.0
        t_sys = read_val(os.path.join(self.hwmon, "temp3_input"), 0) / 1000.0

        self.cpu_fan_row.set_subtitle(f"{cpu_rpm} RPM")
        self.gpu_fan_row.set_subtitle(f"{gpu_rpm} RPM")

        self.cpu_fan_bar.set_fraction(min(1.0, max(0.0, cpu_rpm / 5500.0)))
        self.gpu_fan_bar.set_fraction(min(1.0, max(0.0, gpu_rpm / 5500.0)))

        # Badges for temperature
        if t_cpu >= 80:
            self.cpu_temp_label.set_markup(f"<span foreground='#ff5555' weight='bold'>{int(t_cpu)} °C</span>")
        elif t_cpu >= 68:
            self.cpu_temp_label.set_markup(f"<span foreground='#ffaa33' weight='bold'>{int(t_cpu)} °C</span>")
        else:
            self.cpu_temp_label.set_markup(f"<span foreground='#55ff55' weight='bold'>{int(t_cpu)} °C</span>")

        if t_gpu >= 75:
            self.gpu_temp_label.set_markup(f"<span foreground='#ff5555' weight='bold'>{int(t_gpu)} °C</span>")
        elif t_gpu >= 62:
            self.gpu_temp_label.set_markup(f"<span foreground='#ffaa33' weight='bold'>{int(t_gpu)} °C</span>")
        else:
            self.gpu_temp_label.set_markup(f"<span foreground='#55ff55' weight='bold'>{int(t_gpu)} °C</span>")

        self.sys_temp_label.set_text(f"{int(t_sys)} °C")

        # Synchronize Sliders & Percentage Displays ONLY IF NOT in manual mode
        if not self.manual_switch.get_active():
            if self.current_user_mode == "turbo":
                self.set_sliders_display(100, 100)
            elif self.current_user_mode in ("smart", "auto"):
                pwm1 = read_val(os.path.join(self.hwmon, "pwm1"), 128)
                pwm2 = read_val(os.path.join(self.hwmon, "pwm2"), 128)
                c_pct = max(20, min(100, int(pwm1 * 100 / 255)))
                g_pct = max(20, min(100, int(pwm2 * 100 / 255)))
                self.set_sliders_display(c_pct, g_pct)

    def update_ram(self):
        try:
            with open("/proc/meminfo", "r") as f:
                lines = f.readlines()
            info = {}
            for line in lines:
                parts = line.split(":")
                if len(parts) == 2:
                    info[parts[0].strip()] = int(parts[1].strip().split()[0])
            total_kb = info.get("MemTotal", 1)
            avail_kb = info.get("MemAvailable", 1)
            used_kb = total_kb - avail_kb

            total_gb = total_kb / 1024 / 1024
            used_gb = used_kb / 1024 / 1024
            pct = used_kb / total_kb

            self.ram_usage_row.set_subtitle(f"Использовано: {used_gb:.1f} ГБ из {total_gb:.1f} ГБ ({int(pct*100)}%)")
            self.ram_bar.set_fraction(min(1.0, max(0.0, pct)))

            sw_total = info.get("SwapTotal", 0) / 1024 / 1024
            sw_free = info.get("SwapFree", 0) / 1024 / 1024
            sw_used = max(0, sw_total - sw_free)
            sw_pct = (sw_used / sw_total) if sw_total > 0 else 0
            self.zram_row.set_subtitle(f"Использовано: {sw_used:.1f} ГБ из {sw_total:.1f} ГБ ({int(sw_pct*100)}%)")
            self.zram_bar.set_fraction(min(1.0, max(0.0, sw_pct)))
        except Exception:
            pass

        # Update Top RAM processes
        top_procs = get_top_ram_processes(len(self.ram_proc_rows))
        for i, (row, lbl) in enumerate(self.ram_proc_rows):
            if i < len(top_procs):
                pid, comm, pmem, mb_str = top_procs[i]
                row.set_title(comm)
                row.set_subtitle(f"PID: {pid} | Доля памяти: {pmem}%")
                lbl.set_text(mb_str)
                row.set_visible(True)
            else:
                row.set_visible(False)

    def update_load(self):
        # Update NVIDIA dGPU status
        pci_pm = "/sys/bus/pci/devices/0000:01:00.0/power/runtime_status"
        if os.path.exists(pci_pm):
            try:
                with open(pci_pm, "r") as f:
                    pm_stat = f.read().strip()
                if pm_stat == "suspended":
                    self.dgpu_row.set_subtitle("Режим сна D3cold (0 Вт, чип отключен для экономии энергии)")
                else:
                    self.dgpu_row.set_subtitle("Активна (Используется для 3D/вычислений)")
            except Exception:
                pass

        nv_apps = get_nvidia_processes()
        if nv_apps:
            summary = ", ".join([f"{name} ({vram})" for _, name, vram in nv_apps])
            self.dgpu_apps_row.set_subtitle(summary)
        else:
            self.dgpu_apps_row.set_subtitle("Нет запущенных 3D-процессов (карта спит)")

        # Update Top CPU processes
        top_cpus = get_top_cpu_processes(len(self.cpu_proc_rows))
        for i, (row, lbl) in enumerate(self.cpu_proc_rows):
            if i < len(top_cpus):
                pid, comm, pcpu_str = top_cpus[i]
                row.set_title(comm)
                row.set_subtitle(f"PID: {pid}")
                lbl.set_text(pcpu_str)
                row.set_visible(True)
            else:
                row.set_visible(False)

def main():
    app = Adw.Application(application_id="com.acer.nitrocontrol")
    def on_activate(application):
        win = NitroControlWindow(application=application)
        win.present()
    app.connect("activate", on_activate)
    app.run(sys.argv)

if __name__ == "__main__":
    main()
