#!/usr/bin/env python3
"""
Acer Nitro Control Center (GTK4 / Libadwaita)
Multi-tab system monitor and thermal controller for Acer Nitro AN515-45.
Tabs:
 1. Охлаждение (Fans, Mode Buttons & Dedicated Manual Switch with Slider Locks)
 2. Память ОЗУ (RAM, ZRAM & Top RAM processes)
 3. Нагрузка (CPU load, Top CPU processes & GPU allocation)
"""

import glob
import os
import subprocess
import sys
import gi

gi.require_version('Gtk', '4.0')
gi.require_version('Adw', '1')
from gi.repository import Gtk, Adw, GLib

OVERRIDE_FILE = "/tmp/nitro-fan-override"

def find_ec_hwmon():
    for path in glob.glob("/sys/class/hwmon/hwmon*"):
        name_path = os.path.join(path, "name")
        if os.path.exists(name_path):
            try:
                with open(name_path, "r") as f:
                    if f.read().strip() == "acer_nitro_ec":
                        return path
            except Exception:
                pass
    return None

def read_val(path, default=0):
    try:
        with open(path, "r") as f:
            return int(f.read().strip())
    except Exception:
        return default

def write_val(path, val):
    try:
        with open(path, "w") as f:
            f.write(str(val))
    except Exception:
        pass

def get_top_ram_processes(count=8):
    try:
        res = subprocess.run(
            ["ps", "-eo", "pid,comm,%mem,rss", "--sort=-rss"],
            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True
        )
        lines = res.stdout.strip().splitlines()[1:count+1]
        procs = []
        for line in lines:
            parts = line.split(None, 3)
            if len(parts) == 4:
                pid, comm, pmem, rss = parts
                mb = int(rss) / 1024
                procs.append((pid, comm, pmem, f"{mb:.1f} МБ"))
        return procs
    except Exception:
        return []

def get_top_cpu_processes(count=8):
    try:
        res = subprocess.run(
            ["ps", "-eo", "pid,comm,%cpu", "--sort=-%cpu"],
            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True
        )
        lines = res.stdout.strip().splitlines()[1:count+1]
        procs = []
        for line in lines:
            parts = line.split(None, 2)
            if len(parts) == 3:
                pid, comm, pcpu = parts
                procs.append((pid, comm, f"{pcpu}%"))
        return procs
    except Exception:
        return []

def get_nvidia_processes():
    try:
        res = subprocess.run(
            ["nvidia-smi", "--query-compute-apps=pid,process_name,used_memory", "--format=csv,noheader,nounits"],
            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, timeout=1
        )
        lines = [l.strip() for l in res.stdout.strip().splitlines() if l.strip()]
        apps = []
        for line in lines:
            parts = [p.strip() for p in line.split(",")]
            if len(parts) >= 3:
                apps.append((parts[0], os.path.basename(parts[1]), f"{parts[2]} МБ"))
        return apps
    except Exception:
        return []

class NitroControlWindow(Adw.ApplicationWindow):
    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        self.set_title("Acer Nitro Control Center")
        self.set_default_size(580, 770)

        self.updating_programmatically = False
        self.current_user_mode = "smart"  # 'auto', 'smart', 'turbo', 'manual'

        # Force Dark Mode
        Adw.StyleManager.get_default().set_color_scheme(Adw.ColorScheme.FORCE_DARK)

        self.hwmon = find_ec_hwmon()

        toolbar = Adw.ToolbarView()
        header = Adw.HeaderBar()

        # Tabs stack
        self.stack = Adw.ViewStack()

        # Switcher in Header
        switcher = Adw.ViewSwitcher()
        switcher.set_stack(self.stack)
        header.set_title_widget(switcher)
        toolbar.add_top_bar(header)

        # ----------------------------------------------------
        # Tab 1: Fans & Cooling
        # ----------------------------------------------------
        self.tab_fans = self.create_fans_tab()
        self.stack.add_titled_with_icon(self.tab_fans, "fans", "Охлаждение", "utilities-system-monitor-symbolic")

        # ----------------------------------------------------
        # Tab 2: RAM & Memory
        # ----------------------------------------------------
        self.tab_ram = self.create_ram_tab()
        self.stack.add_titled_with_icon(self.tab_ram, "ram", "ОЗУ", "drive-harddisk-symbolic")

        # ----------------------------------------------------
        # Tab 3: CPU & GPU Load
        # ----------------------------------------------------
        self.tab_load = self.create_load_tab()
        self.stack.add_titled_with_icon(self.tab_load, "load", "Нагрузка", "speedometer-symbolic")

        toolbar.set_content(self.stack)
        self.set_content(toolbar)

        # Initialize manual toggle state from override file
        if os.path.exists(OVERRIDE_FILE):
            try:
                with open(OVERRIDE_FILE, "r") as f:
                    ov = f.read().strip().lower()
                if ov.startswith("manual:"):
                    self.manual_switch.set_active(True)
                elif ov == "turbo":
                    self.current_user_mode = "turbo"
                elif ov == "auto":
                    self.current_user_mode = "auto"
            except Exception:
                pass

        # Timer for real-time updates (1 second)
        self.update_all()
        GLib.timeout_add_seconds(1, self.update_all)

    # ------------------------------------------------------------------
    # TAB 1: Fans UI with Manual Control Toggle
    # ------------------------------------------------------------------
    def create_fans_tab(self):
        scroller = Gtk.ScrolledWindow()
        scroller.set_vexpand(True)
        scroller.set_hexpand(True)

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        box.set_margin_top(16)
        box.set_margin_bottom(20)
        box.set_margin_start(18)
        box.set_margin_end(18)

        clamp = Adw.Clamp(maximum_size=600)
        clamp.set_child(box)
        scroller.set_child(clamp)

        # Group 1: Gauges & Temperatures
        fan_group = Adw.PreferencesGroup(title="Датчики кулеров и температуры")
        box.append(fan_group)

        self.cpu_fan_row = Adw.ActionRow(title="Кулер процессора (CPU)", subtitle="Опрос...")
        self.cpu_fan_bar = Gtk.ProgressBar()
        self.cpu_fan_bar.set_valign(Gtk.Align.CENTER)
        self.cpu_fan_bar.set_size_request(130, -1)
        self.cpu_temp_label = Gtk.Label(label="-- °C")
        self.cpu_temp_label.add_css_class("title-3")
        self.cpu_fan_row.add_suffix(self.cpu_temp_label)
        self.cpu_fan_row.add_suffix(self.cpu_fan_bar)
        fan_group.add(self.cpu_fan_row)

        self.gpu_fan_row = Adw.ActionRow(title="Кулер видеокарты (GPU)", subtitle="Опрос...")
        self.gpu_fan_bar = Gtk.ProgressBar()
        self.gpu_fan_bar.set_valign(Gtk.Align.CENTER)
        self.gpu_fan_bar.set_size_request(130, -1)
        self.gpu_temp_label = Gtk.Label(label="-- °C")
        self.gpu_temp_label.add_css_class("title-3")
        self.gpu_fan_row.add_suffix(self.gpu_temp_label)
        self.gpu_fan_row.add_suffix(self.gpu_fan_bar)
        fan_group.add(self.gpu_fan_row)

        self.sys_temp_row = Adw.ActionRow(title="Материнская плата (EC)", subtitle="Температура корпуса")
        self.sys_temp_label = Gtk.Label(label="-- °C")
        self.sys_temp_label.add_css_class("title-4")
        self.sys_temp_row.add_suffix(self.sys_temp_label)
        fan_group.add(self.sys_temp_row)

        # Group 2: Modes & Manual Control
        ctrl_group = Adw.PreferencesGroup(title="Управление режимами охлаждения")
        box.append(ctrl_group)

        # Manual Toggle Switch
        self.manual_switch = Adw.SwitchRow(
            title="Ручное управление оборотами",
            subtitle="Отключает автоматические кнопки и передает контроль ползункам"
        )
        self.manual_switch.connect("notify::active", self.on_manual_toggle)
        ctrl_group.add(self.manual_switch)

        # Mode Buttons Box
        self.btn_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        self.btn_box.set_homogeneous(True)
        self.btn_box.set_margin_top(8)
        self.btn_box.set_margin_bottom(10)

        self.btn_auto = Gtk.Button(label="Заводской (Тихий)")
        self.btn_auto.connect("clicked", self.on_mode_auto)
        self.btn_box.append(self.btn_auto)

        self.btn_smart = Gtk.Button(label="Умный Автофан")
        self.btn_smart.add_css_class("suggested-action")
        self.btn_smart.connect("clicked", self.on_mode_smart)
        self.btn_box.append(self.btn_smart)

        self.btn_turbo = Gtk.Button(label="ТУРБО (100%)")
        self.btn_turbo.add_css_class("destructive-action")
        self.btn_turbo.connect("clicked", self.on_mode_turbo)
        self.btn_box.append(self.btn_turbo)
        ctrl_group.add(self.btn_box)

        # Sliders with Percentage Display
        self.slider_row_cpu = Adw.ActionRow(title="Скорость обдува CPU")
        self.scale_cpu = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 20, 100, 1)
        self.scale_cpu.set_value(50)
        self.scale_cpu.set_size_request(150, -1)
        self.scale_cpu.set_sensitive(False)  # Disabled until manual switch is ON
        self.scale_cpu.connect("value-changed", self.on_manual_change)

        self.cpu_pct_label = Gtk.Label(label="50%")
        self.cpu_pct_label.set_size_request(55, -1)
        self.cpu_pct_label.add_css_class("title-4")

        self.slider_row_cpu.add_suffix(self.scale_cpu)
        self.slider_row_cpu.add_suffix(self.cpu_pct_label)
        ctrl_group.add(self.slider_row_cpu)

        self.slider_row_gpu = Adw.ActionRow(title="Скорость обдува GPU")
        self.scale_gpu = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 20, 100, 1)
        self.scale_gpu.set_value(50)
        self.scale_gpu.set_size_request(150, -1)
        self.scale_gpu.set_sensitive(False)  # Disabled until manual switch is ON
        self.scale_gpu.connect("value-changed", self.on_manual_change)

        self.gpu_pct_label = Gtk.Label(label="50%")
        self.gpu_pct_label.set_size_request(55, -1)
        self.gpu_pct_label.add_css_class("title-4")

        self.slider_row_gpu.add_suffix(self.scale_gpu)
        self.slider_row_gpu.add_suffix(self.gpu_pct_label)
        ctrl_group.add(self.slider_row_gpu)

        self.fan_status_label = Gtk.Label(label="Текущий режим: Умный Автофан активен")
        self.fan_status_label.add_css_class("dim-label")
        box.append(self.fan_status_label)

        return scroller

    # ------------------------------------------------------------------
    # TAB 2: RAM & Memory UI
    # ------------------------------------------------------------------
    def create_ram_tab(self):
        scroller = Gtk.ScrolledWindow()
        scroller.set_vexpand(True)
        scroller.set_hexpand(True)

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        box.set_margin_top(16)
        box.set_margin_bottom(20)
        box.set_margin_start(18)
        box.set_margin_end(18)

        clamp = Adw.Clamp(maximum_size=600)
        clamp.set_child(box)
        scroller.set_child(clamp)

        overview_group = Adw.PreferencesGroup(title="Состояние оперативной памяти")
        box.append(overview_group)

        self.ram_summary_row = Adw.ActionRow(
            title="Физическая память: 16 ГБ",
            subtitle="Доступно ОС: 15.3 ГБ (~700 МБ аппаратно зарезервировано под AMD Radeon VRAM и UEFI)"
        )
        overview_group.add(self.ram_summary_row)

        self.ram_usage_row = Adw.ActionRow(title="Занято ОЗУ", subtitle="0 ГБ / 0 ГБ")
        self.ram_bar = Gtk.ProgressBar()
        self.ram_bar.set_valign(Gtk.Align.CENTER)
        self.ram_bar.set_size_request(140, -1)
        self.ram_usage_row.add_suffix(self.ram_bar)
        overview_group.add(self.ram_usage_row)

        self.zram_row = Adw.ActionRow(title="ZRAM (Сжатый Swap в RAM)", subtitle="0 ГБ из 7.5 ГБ")
        self.zram_bar = Gtk.ProgressBar()
        self.zram_bar.set_valign(Gtk.Align.CENTER)
        self.zram_bar.set_size_request(140, -1)
        self.zram_row.add_suffix(self.zram_bar)
        overview_group.add(self.zram_row)

        self.top_ram_group = Adw.PreferencesGroup(title="Программы, потребляющие больше всего ОЗУ")
        box.append(self.top_ram_group)

        self.ram_proc_rows = []
        for _ in range(8):
            row = Adw.ActionRow(title="--", subtitle="--")
            lbl = Gtk.Label(label="--")
            lbl.add_css_class("numeric")
